+private func generateVoiceReplyTimeChip(text: String, color: UIColor) -> UIImage? {
+    let height: CGFloat = 18.0
+    let padding: CGFloat = 6.0
+    let iconSize: CGFloat = 12.0
+    let gap: CGFloat = 2.0
+    let lineHeight: CGFloat = 16.0
+
+    let paragraph = NSMutableParagraphStyle()
+    paragraph.minimumLineHeight = lineHeight
+    paragraph.maximumLineHeight = lineHeight
+    let font = Font.regular(12.0)
+    let attributedText = NSAttributedString(string: text, attributes: [
+        .font: font,
+        .foregroundColor: color,
+        .paragraphStyle: paragraph,
+        .baselineOffset: (lineHeight - font.lineHeight) / 4.0
+    ])
+    let textWidth = ceil(attributedText.boundingRect(with: CGSize(width: 1000.0, height: lineHeight), options: [.usesLineFragmentOrigin], context: nil).width)
+    let size = CGSize(width: padding + iconSize + gap + textWidth + padding, height: height)
+
+    return generateImage(size, rotatedContext: { size, context in
+        context.clear(CGRect(origin: CGPoint(), size: size))
+        context.setFillColor(color.withAlphaComponent(0.1).cgColor)
+        context.addPath(UIBezierPath(roundedRect: CGRect(origin: CGPoint(), size: size), cornerRadius: size.height / 2.0).cgPath)
+        context.fillPath()
+
+        UIGraphicsPushContext(context)
+        if let symbol = UIImage(systemName: "play.fill", withConfiguration: UIImage.SymbolConfiguration(pointSize: 40.0, weight: .regular))?.withTintColor(color, renderingMode: .alwaysOriginal) {
+            let scale = min(iconSize / symbol.size.width, iconSize / symbol.size.height)
+            let iconFrame = CGRect(x: padding, y: floor((size.height - symbol.size.height * scale) / 2.0), width: symbol.size.width * scale, height: symbol.size.height * scale)
+            symbol.draw(in: iconFrame)
+        }
+        attributedText.draw(in: CGRect(x: padding + iconSize + gap, y: floor((size.height - lineHeight) / 2.0), width: textWidth + 2.0, height: lineHeight))
+        UIGraphicsPopContext()
+    })
+}
