+/// Editable message-body quote, NOT MTProto reply quote_text: an audio transcript is not message.text.
+/// The ordinary reply relation is installed separately. Nothing here sends a message or mutates the source.
+/// 4096 UTF-16 units is the existing text composer limit in this host; refuse, never silently truncate.
+func voiceReplyInputState(inputState: ChatTextInputState, fragment: VoiceReplyFragment) -> ChatTextInputState? {
+    guard !fragment.timeText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+          !fragment.text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+        return nil
+    }
+    let text = "\(fragment.timeText) — \(fragment.text)"
+    let prefixLength = (text as NSString).length + 2
+    let existingLength = expandedInputStateAttributedString(inputState.inputText).length
+    guard prefixLength <= 4096, existingLength <= 4096 - prefixLength else {
+        return nil
+    }
+
+    let quote = NSAttributedString(string: text, attributes: [
+        ChatTextInputAttributes.block: ChatTextInputTextQuoteAttribute(kind: .quote, isCollapsed: false)
+    ])
+    var quoteContent = ChatTextInputState(inputText: quote).content
+    // This pinned host's legacy attributed-string importer may flatten block attributes. Keep the
+    // prefix a real blockquote even on that bridge; never round-trip the EXISTING draft through it.
+    if quoteContent.blocks.count != 1 || !voiceReplyIsBlockQuote(quoteContent.blocks[0]) {
+        quoteContent = ChatInputContent(blocks: [.blockQuote(ChatInputBlockQuote(
+            content: ChatTextInputState(inputText: NSAttributedString(string: text)).content,
+            collapsed: false
+        ))])
+    }
+    var content = inputState.content
+    if content.blocks.isEmpty {
+        content.blocks = [.paragraph(ChatInputParagraph(runs: []))]
+    }
+    // Block separators supply exactly `${time} — ${text}\n\n` before the untouched original blocks.
+    content.blocks.insert(contentsOf: quoteContent.blocks + [.paragraph(ChatInputParagraph(runs: []))], at: 0)
+    let selection = inputState.selectionRange
+    return ChatTextInputState(content: content, selectionRange: (selection.lowerBound + prefixLength) ..< (selection.upperBound + prefixLength))
+}
+
+private func voiceReplyIsBlockQuote(_ block: ChatInputBlock) -> Bool {
+    if case .blockQuote = block {
+        return true
+    }
+    return false
+}
