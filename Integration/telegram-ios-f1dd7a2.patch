diff --git a/submodules/AccountContext/Sources/VoiceReplyFragment.swift b/submodules/AccountContext/Sources/VoiceReplyFragment.swift
new file mode 100644
index 0000000..6d40491
--- /dev/null
+++ b/submodules/AccountContext/Sources/VoiceReplyFragment.swift
@@ -0,0 +1,46 @@
+import Foundation
+import TelegramCore
+
+/// The part of a voice message a reply is about, chosen in the voice transcript sheet: the time (or time range) it covers as it
+/// reads there, and the text of the chosen words. At explicit Quote, the chat consumes this handoff into
+/// an editable, timestamped body blockquote plus an ordinary reply link. Only the user's normal Send sends it.
+/// Audio transcript text is not message.text and must not be passed as MTProto reply quote_text.
+public struct VoiceReplyFragment: Codable, Equatable {
+    public var timeText: String
+    public var text: String
+
+    public init(timeText: String, text: String) {
+        self.timeText = timeText
+        self.text = text
+    }
+}
+
+/// Holds a chosen fragment for the moment between pressing Reply in the transcript sheet and the chat setting the reply up:
+/// the chat opens asynchronously and sets the reply by message id alone, so this is how the fragment reaches it. It is read
+/// once, and goes stale after a few seconds. Main thread only.
+public final class VoiceReplyFragmentStore {
+    public static let shared = VoiceReplyFragmentStore()
+
+    private var pending: (id: EngineMessage.Id, accountId: Int64, fragment: VoiceReplyFragment, date: Double)?
+
+    private init() {
+    }
+
+    public func set(_ fragment: VoiceReplyFragment, for id: EngineMessage.Id, accountId: Int64) {
+        self.pending = (id, accountId, fragment, CFAbsoluteTimeGetCurrent())
+    }
+
+    public func take(for id: EngineMessage.Id, accountId: Int64) -> VoiceReplyFragment? {
+        guard let pending = self.pending else {
+            return nil
+        }
+        if pending.id != id || pending.accountId != accountId {
+            return nil
+        }
+        self.pending = nil
+        if CFAbsoluteTimeGetCurrent() - pending.date > 15.0 {
+            return nil
+        }
+        return pending.fragment
+    }
+}
